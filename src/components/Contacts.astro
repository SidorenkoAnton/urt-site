---
import { site } from '../data/site';
---

<section class="contacts" id="contacts">
  <div class="container contacts__grid">
    <div class="contacts__lead">
      <p class="eyebrow eyebrow--light">06 — Контакты</p>
      <h2>Обсудим ваш проект</h2>
      <p>
        Расскажите о задаче — предложим техническое решение и оценим объём работ.
        Отвечаем в рабочее время, по крупным объектам выезжаем на встречу.
      </p>
    </div>

    <div class="contacts__card">
      <a class="contacts__phone" href={site.phoneHref}>{site.phoneLabel}</a>
      <a class="contacts__mail" href={site.emailHref}>{site.email}</a>
      <p class="contacts__hours">{site.hours}</p>

      <div class="contacts__actions">
        <a class="btn btn--accent" href={site.phoneHref}>Позвонить</a>
        <a class="btn contacts__ghost" href={site.emailHref}>Написать на почту</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contacts {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--navy);
    color: var(--on-dark);
  }

  .contacts__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contacts h2 {
    margin-top: 1.1rem;
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .contacts__lead p:last-child {
    margin-top: 1.25rem;
    max-width: 30rem;
    color: var(--on-dark-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .contacts__card {
    padding-top: 0.4rem;
  }

  .contacts__phone {
    display: inline-block;
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    transition: color 0.2s var(--ease);
  }

  .contacts__phone:hover {
    color: #e9a58c;
  }

  .contacts__mail {
    display: inline-block;
    margin-top: 0.9rem;
    color: var(--on-dark);
    font-size: 1.05rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    transition: border-color 0.2s var(--ease);
  }

  .contacts__mail:hover {
    border-color: var(--accent);
  }

  .contacts__hours {
    margin-top: 1rem;
    color: var(--on-dark-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contacts__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .contacts__ghost {
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--on-dark);
  }

  .contacts__ghost:hover {
    border-color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 820px) {
    .contacts__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
