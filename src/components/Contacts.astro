---
import { site } from '../data/site';
---

<section class="section section--dark contacts" id="contacts">
  <div class="container contacts__grid">
    <div class="contacts__lead">
      <p class="kicker kicker--light">06 — Контакты</p>
      <h2>Обсудим вашу трассу</h2>
      <p>
        Расскажите о задаче — предложим техническое решение и оценим объём
        работ. По крупным объектам выезжаем на встречу.
      </p>
    </div>

    <div class="contacts__card">
      <a class="contacts__phone" href={site.phoneHref}>{site.phoneLabel}</a>
      <a class="contacts__mail" href={site.emailHref}>{site.email}</a>
      <p class="contacts__hours">{site.hours}</p>

      <div class="contacts__actions">
        <a class="btn btn--accent" href={site.phoneHref}>Позвонить</a>
        <a class="btn btn--ghost-light" href={site.emailHref}>Написать на почту</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contacts {
    position: relative;
    padding-block: clamp(4rem, 8vw, 7rem);
    background:
      radial-gradient(80% 120% at 100% 0%, rgba(111, 211, 234, 0.09) 0%, transparent 55%),
      var(--navy);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .contacts__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contacts h2 {
    margin-top: 1rem;
    font-size: clamp(2rem, 4vw, 3.3rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--on-dark);
  }

  .contacts__lead p:last-child {
    margin-top: 1.2rem;
    max-width: 28rem;
    color: var(--on-dark-muted);
    line-height: 1.65;
  }

  .contacts__card {
    padding-left: clamp(0rem, 3vw, 3rem);
    border-left: 1px solid rgba(255, 255, 255, 0.14);
  }

  .contacts__phone {
    display: inline-block;
    font-size: clamp(1.7rem, 3.4vw, 2.8rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--on-dark);
    font-variant-numeric: tabular-nums;
    transition: color 0.2s var(--ease);
  }

  .contacts__phone:hover {
    color: var(--accent-bright);
  }

  .contacts__mail {
    display: inline-block;
    margin-top: 0.8rem;
    color: var(--on-dark);
    font-size: 1.05rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    transition: border-color 0.2s var(--ease);
  }

  .contacts__mail:hover {
    border-color: var(--accent-bright);
  }

  .contacts__hours {
    margin-top: 0.9rem;
    color: var(--on-dark-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contacts__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }

  @media (max-width: 820px) {
    .contacts__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contacts__card {
      padding-left: 0;
      padding-top: 1.5rem;
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
  }

  @media (max-width: 480px) {
    .contacts__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
