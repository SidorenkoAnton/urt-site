---
import { steps, districts } from '../data/site';
---

<section class="section process" id="process">
  <div class="container">
    <header class="sec-head">
      <span class="sec-index" aria-hidden="true">05</span>
      <div>
        <p class="kicker">Как работаем</p>
        <h2>Четыре этапа до сдачи линии</h2>
        <p class="lead">
          Каждый этап фиксируем в договоре и документации — вы понимаете,
          что происходит на объекте и когда получите результат.
        </p>
      </div>
    </header>

    <ol class="steps">
      {steps.map((step, index) => (
        <li class="step">
          <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="geo">
      <p class="geo__label">География</p>
      <p class="geo__text">
        Работаем по всей России — от городской линии
        до магистрали через несколько регионов.
      </p>
      <ul class="geo__list">
        {districts.map((district) => <li>{district}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2.5vw, 2.25rem);
    padding-top: 1.9rem;
  }

  .steps::before {
    content: "";
    position: absolute;
    top: 0.32rem;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line-strong);
  }

  .step {
    position: relative;
  }

  .step::before {
    content: "";
    position: absolute;
    top: -1.9rem;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--paper);
  }

  .step__num {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
  }

  .step h3 {
    margin-top: 0.9rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .step p {
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .geo {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .geo__label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .geo__text {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .geo__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .geo__list li {
    padding: 0.24rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .steps::before {
      display: none;
    }

    .step {
      padding-top: 1.3rem;
      border-top: 1px solid var(--line-strong);
    }

    .step::before {
      top: -4px;
    }

    .geo {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
