---
import { services } from '../data/site';
---

<section class="section" id="services">
  <div class="container">
    <header class="sec-head">
      <span class="sec-index" aria-hidden="true">02</span>
      <div>
        <p class="kicker">Услуги</p>
        <h2>Полный цикл работ по линии</h2>
        <p class="lead">
          Один договор и один ответственный подрядчик — от первого выезда
          на трассу до подписи в акте приёмки.
        </p>
      </div>
    </header>

    <ul class="services">
      {services.map((service, index) => (
        <li class="service">
          <span class="service__num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
          <span class="service__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    border-top: 1px solid var(--line-strong);
  }

  .service {
    display: grid;
    grid-template-columns: 4.5rem 1fr 1.05fr 2rem;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: baseline;
    padding: clamp(1.35rem, 2.4vw, 1.9rem) 0;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.25s var(--ease);
  }

  .service:hover {
    background: rgba(255, 255, 255, 0.55);
  }

  .service__num {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    transition: color 0.2s var(--ease);
  }

  .service:hover .service__num {
    color: var(--accent);
  }

  .service h3 {
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .service p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .service__mark {
    align-self: center;
    justify-self: end;
    color: var(--line-strong);
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .service__mark svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .service:hover .service__mark {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 900px) {
    .service {
      grid-template-columns: 3rem 1fr;
      gap: 0.4rem 1rem;
    }

    .service h3 {
      grid-column: 2;
    }

    .service p {
      grid-column: 2;
      margin-top: 0.35rem;
    }

    .service__mark {
      display: none;
    }
  }
</style>
