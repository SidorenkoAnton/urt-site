---
import { Image } from 'astro:assets';
import cable from '../assets/cable.jpg';
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Строительство ВОЛС · Юг России</p>

      <h1>Оптические линии связи <span class="hero__mark">под ключ</span></h1>

      <p class="hero__lead">
        Проектируем и строим магистральные и внутризоновые ВОЛС по всей России.
        Собственная техника, аттестованные монтажники и полный пакет документации.
      </p>

      <div class="hero__actions">
        <a class="btn btn--accent" href="#contacts">
          Обсудить проект
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 12h15M13 6l6 6-6 6" />
          </svg>
        </a>
        <a class="btn btn--outline" href="#projects">Смотреть проекты</a>
      </div>

      <p class="hero__note">
        <span>Допуск СРО</span>
        <span>12 лет на рынке</span>
        <span>Работаем по всей РФ</span>
      </p>
    </div>

    <figure class="hero__media">
      <div class="hero__frame">
        <Image
          src={cable}
          alt="Кабелеукладочная техника на трассе магистральной линии связи"
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 92vw, 44vw"
          format="webp"
          quality={70}
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__frame-line" aria-hidden="true"></span>
      </div>
      <figcaption>
        <span class="hero__index">01</span>
        Магистральный участок · прокладка в грунт
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3rem, 6vw, 5.5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .hero h1 {
    margin-top: 1.35rem;
    font-size: clamp(2.45rem, 5.2vw, 4.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .hero__mark {
    color: var(--accent);
    white-space: nowrap;
  }

  .hero__lead {
    margin-top: 1.5rem;
    max-width: 33rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.1rem;
  }

  .hero__note {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-top: 2.4rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__note span {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hero__note span + span::before {
    content: "";
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-deep);
  }

  .hero__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__frame-line {
    position: absolute;
    inset: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 2px;
    pointer-events: none;
  }

  .hero__media figcaption {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.85rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__index {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero__frame {
      aspect-ratio: 16 / 11;
    }
  }

  @media (max-width: 560px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__note {
      gap: 0.45rem 1rem;
      font-size: 0.64rem;
    }
  }
</style>
