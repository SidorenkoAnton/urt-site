---
import { Image } from 'astro:assets';
import cable from '../assets/cable.jpg';
import { metrics } from '../data/site';

const contourPath = (cx: number, cy: number, baseR: number, seed: number) => {
  const steps = 72;
  let d = '';
  for (let i = 0; i <= steps; i += 1) {
    const t = (i / steps) * Math.PI * 2;
    const r =
      baseR +
      18 * Math.sin(3 * t + seed) +
      9 * Math.cos(5 * t - seed * 0.6) +
      5 * Math.sin(7 * t + seed * 1.7);
    const x = cx + r * 1.65 * Math.cos(t);
    const y = cy + r * 0.82 * Math.sin(t) + 10 * Math.sin(2 * t + seed);
    d += `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)} `;
  }
  return `${d}Z`;
};

const contours = Array.from({ length: 11 }, (_, i) =>
  contourPath(1030, 330, 55 + i * 44, i * 0.62),
);

const route =
  'M -60 660 C 170 640 250 540 450 540 C 650 540 740 610 930 585 C 1120 560 1210 450 1400 452 C 1470 453 1510 470 1560 458';

const crosses = [
  [96, 118],
  [1338, 96],
  [214, 690],
  [1196, 668],
  [760, 74],
];
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true">
    <svg class="hero__map" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice">
      <g class="hero__contours">
        {contours.map((d) => <path d={d} />)}
      </g>

      <path id="hero-route" class="hero__route" d={route} />
      <path class="hero__route hero__route--dash" d={route} />

      <circle class="hero__packet" r="3">
        <animateMotion dur="16s" repeatCount="indefinite" begin="-2s">
          <mpath href="#hero-route" />
        </animateMotion>
      </circle>
      <circle class="hero__packet hero__packet--slow" r="2">
        <animateMotion dur="23s" repeatCount="indefinite" begin="-11s">
          <mpath href="#hero-route" />
        </animateMotion>
      </circle>

      <g class="hero__crosses">
        {crosses.map(([x, y]) => (
          <g transform={`translate(${x} ${y})`}>
            <path d="M -7 0 H 7 M 0 -7 V 7" />
          </g>
        ))}
      </g>
    </svg>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="kicker kicker--light">Строительство ВОЛС · Россия</p>

      <h1>Оптика, которая<br />соединяет <span>города</span></h1>

      <p class="hero__lead">
        Проектируем и строим магистральные и внутризоновые линии связи под ключ.
        Собственная техника, инженеры и допуск СРО.
      </p>

      <div class="hero__actions">
        <a class="btn btn--accent" href="#contacts">
          Обсудить проект
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 12h15M13 6l6 6-6 6" />
          </svg>
        </a>
        <a class="btn btn--ghost-light" href="#projects">Смотреть проекты</a>
      </div>

      <ul class="hero__scope">
        <li>Изыскания</li>
        <li>СМР</li>
        <li>Измерения</li>
        <li>Паспортизация</li>
      </ul>
    </div>

    <aside class="passport" aria-label="Паспорт объекта">
      <div class="passport__head">
        <span>Паспорт компании</span>
        <span>СРО · РФ</span>
      </div>

      <svg class="passport__map" viewBox="0 0 260 96" aria-hidden="true">
        <path d="M 12 66 C 56 66 70 28 118 28 C 166 28 186 70 248 44" />
        <circle cx="12" cy="66" r="3.5" />
        <circle cx="118" cy="28" r="3.5" />
        <circle cx="248" cy="44" r="3.5" />
      </svg>

      <div class="passport__labels" aria-hidden="true">
        <span>Изыскания</span>
        <span>СМР</span>
        <span>Сдача</span>
      </div>

      <dl class="passport__rows">
        <div><dt>Построено</dt><dd>4 500 км</dd></div>
        <div><dt>Техника</dt><dd>85 ед.</dd></div>
        <div><dt>Опыт</dt><dd>12 лет</dd></div>
      </dl>

      <p class="passport__foot">Допуск СРО · Проектирование и строительство</p>
    </aside>
  </div>

  <div class="hero__metrics">
    <div class="container hero__metrics-grid">
      {metrics.map((metric) => (
        <div class="hero__metric">
          <span class="hero__metric-value">{metric.value}<i>{metric.unit}</i></span>
          <span class="hero__metric-label">{metric.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(2.75rem, 7vh, 5.5rem);
    background:
      radial-gradient(120% 90% at 85% 10%, rgba(17, 62, 82, 0.55) 0%, transparent 60%),
      var(--navy);
    color: var(--on-dark);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.9;
  }

  .hero__map {
    width: 100%;
    height: 100%;
  }

  .hero__contours path {
    fill: none;
    stroke: rgba(111, 211, 234, 0.16);
    stroke-width: 1;
  }

  .hero__route {
    fill: none;
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 1;
  }

  .hero__route--dash {
    stroke: var(--accent-bright);
    stroke-width: 1.6;
    stroke-dasharray: 4 12;
    stroke-linecap: round;
    opacity: 0.8;
    animation: route-flow 26s linear infinite;
  }

  @keyframes route-flow {
    to {
      stroke-dashoffset: -640;
    }
  }

  .hero__packet {
    fill: var(--cyan);
    filter: drop-shadow(0 0 6px rgba(111, 211, 234, 0.9));
  }

  .hero__packet--slow {
    fill: var(--accent-bright);
    filter: drop-shadow(0 0 6px rgba(255, 122, 61, 0.85));
  }

  .hero__crosses path {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.72fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3rem, 6vw, 5rem);
  }

  .hero h1 {
    margin-top: 1.15rem;
    font-size: clamp(2.6rem, 5.3vw, 4.7rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--on-dark);
    text-wrap: balance;
  }

  .hero h1 span {
    color: var(--accent-bright);
  }

  .hero__lead {
    margin-top: 1.4rem;
    max-width: 31rem;
    color: var(--on-dark-muted);
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .hero__scope {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 2.3rem;
  }

  .hero__scope li {
    padding: 0.3rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    color: var(--on-dark-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ---------- passport ---------- */
  .passport {
    position: relative;
    padding: 1.35rem 1.4rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.035);
    backdrop-filter: blur(6px);
  }

  .passport::before,
  .passport::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--accent-bright);
    border-style: solid;
  }

  .passport::before {
    top: -1px;
    left: -1px;
    border-width: 1px 0 0 1px;
  }

  .passport::after {
    right: -1px;
    bottom: -1px;
    border-width: 0 1px 1px 0;
  }

  .passport__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--on-dark-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .passport__map {
    width: 100%;
    height: auto;
    margin-top: 1.2rem;
    overflow: visible;
  }

  .passport__map path {
    fill: none;
    stroke: rgba(111, 211, 234, 0.7);
    stroke-width: 1.2;
    stroke-dasharray: 5 6;
  }

  .passport__map circle {
    fill: var(--navy);
    stroke: var(--accent-bright);
    stroke-width: 1.6;
  }

  .passport__labels {
    display: flex;
    justify-content: space-between;
    margin-top: 0.35rem;
    color: var(--on-dark-muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .passport__rows {
    margin-top: 1.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .passport__rows div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .passport__rows dt {
    color: var(--on-dark-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .passport__rows dd {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .passport__foot {
    margin-top: 1rem;
    color: var(--on-dark-muted);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  /* ---------- metrics ---------- */
  .hero__metrics {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    background: rgba(6, 26, 36, 0.55);
  }

  .hero__metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .hero__metric {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.35rem 1.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero__metric:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .hero__metric-value {
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .hero__metric-value i {
    margin-left: 0.3rem;
    color: var(--on-dark-muted);
    font-size: 0.42em;
    font-style: normal;
    font-weight: 500;
  }

  .hero__metric-label {
    color: var(--on-dark-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__route--dash {
      animation: none;
    }

    .hero__packet {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .passport {
      max-width: 26rem;
    }

    .hero__metrics-grid {
      grid-template-columns: 1fr 1fr;
    }

    .hero__metric:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }

    .hero__metric:nth-child(n + 3) {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  @media (max-width: 560px) {
    .hero h1 {
      font-size: clamp(2.3rem, 10vw, 3rem);
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .hero__metric {
      padding: 1rem 0.9rem;
    }

    .hero__metric:nth-child(odd) {
      padding-left: 0;
    }
  }
</style>
