---
const items = [
  { id: 'about', label: 'О компании' },
  { id: 'services', label: 'Услуги' },
  { id: 'projects', label: 'Проекты' },
  { id: 'equipment', label: 'Техника' },
  { id: 'process', label: 'Как работаем' },
  { id: 'contacts', label: 'Контакты' },
];
---

<nav class="rail" aria-label="Разделы страницы">
  <ul>
    {items.map((item) => (
      <li>
        <a href={`#${item.id}`} data-rail={item.id}>
          <span class="rail__dot" aria-hidden="true"></span>
          <span class="rail__label">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const links = Array.from(document.querySelectorAll('[data-rail]'));
  const sections = links
    .map((link) => document.getElementById(link.getAttribute('data-rail') || ''))
    .filter(Boolean);

  if (sections.length) {
    const setActive = (id) => {
      links.forEach((link) => {
        link.toggleAttribute('data-active', link.getAttribute('data-rail') === id);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .rail {
    display: none;
    position: fixed;
    left: 1.1rem;
    top: 50%;
    z-index: 40;
    transform: translateY(-50%);
    padding-left: 0.9rem;
  }

  .rail::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 1px;
    background: var(--line-strong);
    opacity: 0.55;
  }

  .rail ul {
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  .rail a {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .rail__dot {
    display: block;
    width: 5px;
    height: 5px;
    margin-left: -0.3rem;
    border-radius: 50%;
    background: var(--line-strong);
    transition:
      background-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .rail__label {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    padding: 0.18rem 0.4rem;
    border: 1px solid var(--line);
    background: var(--paper);
    opacity: 0;
    transform: translateY(-50%) translateX(-4px);
    transition:
      opacity 0.2s var(--ease),
      transform 0.2s var(--ease);
    white-space: nowrap;
    pointer-events: none;
  }

  .rail a:hover .rail__label,
  .rail a:focus-visible .rail__label {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  .rail a:hover .rail__dot,
  .rail a[data-active] .rail__dot {
    background: var(--accent);
    transform: scale(1.5);
  }

  @media (min-width: 1440px) {
    .rail {
      display: block;
    }
  }
</style>
