---
import { Image } from 'astro:assets';
import { equipment } from '../data/site';
import cable from '../assets/cable.jpg';
import factory from '../assets/factory.jpg';
import svarka from '../assets/svarka.jpg';
import office from '../assets/office.jpg';

const images = [cable, factory, svarka, office];
const alts = [
  'Кабелеукладочная техника компании',
  'Производственная база со складом',
  'Сварочный участок и оптические муфты',
  'Офис и инженерный центр',
];

const facts = [
  'Кабелеукладчики и тяговые машины',
  'Оборудование для грунта и ГНБ',
  'Сварка Fujikura и Sumitomo',
  'Измерительные комплексы OTDR',
];
---

<section class="section section--dark equipment" id="equipment">
  <div class="container equipment__container">
    <span class="equipment__ghost" aria-hidden="true">85</span>

    <header class="sec-head equipment__head">
      <span class="sec-index" aria-hidden="true">04</span>
      <div>
        <p class="kicker kicker--light">Техника и база</p>
        <h2>Своя техника, склад и мастерские</h2>
        <p class="lead">
          85 единиц специализированной техники и производственная база
          позволяют не зависеть от субподрядчиков и держать сроки.
        </p>
      </div>
    </header>

    <div class="equipment__body">
      <div class="equipment__copy">
        <ul class="equipment__facts">
          {facts.map((fact) => <li>{fact}</li>)}
        </ul>
        <a class="btn btn--light" href="#contacts">Обсудить проект</a>
      </div>

      <ul class="equipment__gallery">
        {equipment.map((item, index) => (
          <li class="equipment__item">
            <div class="equipment__media">
              <Image
                src={images[index]}
                alt={alts[index]}
                widths={[480, 800, 1200]}
                sizes="(max-width: 900px) 100vw, 32vw"
                format="webp"
                quality={70}
                loading="lazy"
              />
            </div>
            <div class="equipment__caption">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <strong>{item.title}</strong>
                <em>{item.text}</em>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .equipment {
    position: relative;
    overflow: hidden;
  }

  .equipment__container {
    position: relative;
    z-index: 1;
  }

  .equipment__ghost {
    position: absolute;
    right: -0.05em;
    top: -0.35em;
    z-index: 0;
    color: transparent;
    font-size: clamp(18rem, 34vw, 30rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.06em;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.07);
    pointer-events: none;
    user-select: none;
  }

  .equipment__head h2 {
    max-width: 34rem;
  }

  .equipment__body {
    display: grid;
    grid-template-columns: 0.62fr 1.38fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .equipment__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  .equipment__facts {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
  }

  .equipment__facts li {
    position: relative;
    padding: 0.55rem 0 0.55rem 1.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--on-dark-muted);
    font-size: 0.92rem;
  }

  .equipment__facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05em;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--accent-bright);
    transform: rotate(45deg);
  }

  .equipment__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .equipment__media {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: var(--navy-2);
  }

  .equipment__media :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .equipment__item:hover .equipment__media :global(img) {
    transform: scale(1.03);
  }

  .equipment__caption {
    display: flex;
    gap: 0.65rem;
    margin-top: 0.6rem;
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .equipment__caption > span {
    color: var(--accent-bright);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    padding-top: 0.15rem;
  }

  .equipment__caption strong {
    display: block;
    color: var(--on-dark);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .equipment__caption em {
    color: var(--on-dark-muted);
    font-style: normal;
  }

  @media (max-width: 900px) {
    .equipment__body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 720px) {
    .equipment__ghost {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .equipment__gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
