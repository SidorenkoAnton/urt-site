---
import { Image } from 'astro:assets';
import { equipmentPhotos } from '../data/site';
import factory from '../assets/factory.jpg';
import office from '../assets/office.jpg';
import svarka from '../assets/svarka.jpg';
import cable from '../assets/cable.jpg';

const images = [cable, factory, svarka, office];
const alts = [
  'Кабелеукладочная техника компании',
  'Производственная база со складом',
  'Сварочный участок и оптические муфты',
  'Офис и инженерный центр',
];
---

<section class="equipment" id="equipment">
  <div class="container equipment__grid">
    <div class="equipment__copy">
      <p class="eyebrow">04 — Техника и база</p>
      <h2>Своя техника, склад и ремонтная база</h2>
      <p class="lead">
        85 единиц специализированной техники, крытый склад и мастерские позволяют
        не зависеть от субподрядчиков и держать сроки даже на больших участках.
      </p>

      <ul class="equipment__facts">
        <li>Кабелеукладчики и тяговые машины</li>
        <li>Оборудование для прокладки в грунт и ГНБ</li>
        <li>Сварочные аппараты Fujikura и Sumitomo</li>
        <li>Измерительные комплексы OTDR</li>
      </ul>

      <a class="btn btn--ink" href="#contacts">Обсудить проект</a>
    </div>

    <ul class="equipment__gallery">
      {equipmentPhotos.map((photo, index) => (
        <li class="equipment__item">
          <div class="equipment__media">
            <Image
              src={images[index]}
              alt={alts[index]}
              widths={[480, 800, 1200]}
              sizes="(max-width: 900px) 100vw, 30vw"
              format="webp"
              quality={70}
              loading="lazy"
            />
          </div>
          <div class="equipment__caption">
            <span class="equipment__num">{String(index + 1).padStart(2, '0')}</span>
            <span>
              <strong>{photo.title}</strong>
              <span>{photo.text}</span>
            </span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .equipment {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--paper-deep);
    border-block: 1px solid var(--line);
  }

  .equipment__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .equipment h2 {
    margin-top: 1.1rem;
    font-size: clamp(1.85rem, 3.4vw, 2.9rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .equipment__facts {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-block: 1.8rem 2.2rem;
  }

  .equipment__facts li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .equipment__facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.65rem;
    height: 2px;
    background: var(--accent);
  }

  .equipment__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .equipment__media {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper);
  }

  .equipment__media :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .equipment__item:hover .equipment__media :global(img) {
    transform: scale(1.03);
  }

  .equipment__caption {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: 0.65rem;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .equipment__num {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }

  .equipment__caption strong {
    display: block;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .equipment__caption span span {
    color: var(--muted);
  }

  .equipment__item:first-child .equipment__media :global(img) {
    object-position: 64% 72%;
  }

  @media (max-width: 900px) {
    .equipment__grid {
      grid-template-columns: 1fr;
    }

    .equipment__gallery {
      order: -1;
    }
  }

  @media (max-width: 520px) {
    .equipment__gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
