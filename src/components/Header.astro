---
import { site, navigation } from '../data/site';
import Logo from '../layouts/Logo.astro';
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="brand" href="/" aria-label={`${site.name} — на главную`}>
      <Logo />
    </a>

    <nav class="nav" aria-label="Основная навигация">
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={site.phoneHref}>{site.phoneLabel}</a>
      <a class="btn btn--accent header__cta" href="#contacts">Обсудить проект</a>
      <button
        class="burger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Открыть меню"
        data-burger
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-panel hidden>
    <nav class="container" aria-label="Мобильная навигация">
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href} data-nav-link>{item.label}</a></li>
        ))}
      </ul>
      <div class="mobile-nav__footer">
        <a class="mobile-nav__phone" href={site.phoneHref}>{site.phoneLabel}</a>
        <a class="mobile-nav__mail" href={site.emailHref}>{site.email}</a>
        <span class="mobile-nav__hours">{site.hours}</span>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const burger = header?.querySelector('[data-burger]');
  const panel = header?.querySelector('[data-panel]');

  if (header && burger && panel) {
    const setOpen = (open) => {
      panel.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
      document.body.classList.toggle('nav-open', open);
    };

    burger.addEventListener('click', () => setOpen(panel.hidden));

    panel.querySelectorAll('[data-nav-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        burger.focus();
      }
    });

    window.matchMedia('(min-width: 1025px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 70;
    background: var(--navy);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--on-dark);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    flex: none;
  }

  .brand :global(svg) {
    height: clamp(2.6rem, 3.4vw, 3.15rem);
    width: auto;
  }

  .nav {
    margin-left: auto;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--on-dark-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s var(--ease);
  }

  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--accent-bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .nav a:hover {
    color: var(--on-dark);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    flex: none;
  }

  .header__phone {
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .header__phone:hover {
    color: var(--accent-bright);
  }

  .header__cta {
    min-height: 2.55rem;
    padding: 0.45rem 1rem;
    font-size: 0.86rem;
  }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 2.7rem;
    height: 2.7rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
  }

  .burger span {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    margin-inline: auto;
    background: var(--on-dark);
    transition: transform 0.2s var(--ease);
  }

  .burger[aria-expanded="true"] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .burger[aria-expanded="true"] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding-block: 0.5rem 1.5rem;
    background: var(--navy);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .mobile-nav ul {
    padding-block: 0.5rem;
  }

  .mobile-nav li + li {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-nav li a {
    display: block;
    padding-block: 0.9rem;
    font-size: 1.05rem;
  }

  .mobile-nav__footer {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .mobile-nav__phone {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .mobile-nav__mail {
    color: var(--accent-bright);
  }

  .mobile-nav__hours {
    color: var(--on-dark-muted);
    font-size: 0.82rem;
  }

  @media (max-width: 1024px) {
    .nav {
      display: none;
    }

    .header__actions {
      margin-left: auto;
    }

    .burger {
      display: flex;
    }
  }

  @media (max-width: 720px) {
    .header__phone {
      display: none;
    }

    .header__cta {
      min-height: 2.45rem;
      padding: 0.4rem 0.8rem;
      font-size: 0.8rem;
    }

    .brand :global(svg) {
      height: 2.55rem;
    }
  }

  @media (max-width: 480px) {
    .header__cta {
      display: none;
    }
  }
</style>
