---
import cable from '../assets/cable.jpg'
import Logo from './Logo.astro'
---
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ЮЖРЕГИОНТЕЛЕКОМ — Строительство ВОЛС под ключ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=Golos+Text:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-deep: #020617;
            --bg-surface: #0f172a;
            --bg-surface-hover: #1e293b;
            
            --border-default: rgba(255, 255, 255, 0.06);
            --border-hover: rgba(255, 255, 255, 0.15);
            
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            
            --accent-blue: #004ea6;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        
        body {
            font-family: 'Golos Text', sans-serif;
            background-color: var(--bg-deep);
            color: var(--text-primary);
            overflow-x: hidden;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3 { font-family: 'Onest', sans-serif; font-weight: 600; letter-spacing: -0.02em; }
        .mono { font-family: 'JetBrains Mono', monospace; }

        /* =========================================
           НАВИГАЦИЯ
           ========================================= */
        .navbar {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            background: #ffffff;
            border-bottom: 1px solid rgba(0, 0, 0, 0.08);
            padding: 0.75rem 5%;
        }

        .nav-container {
            max-width: 1280px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-link {
            display: flex;
            align-items: center;
            text-decoration: none;
            padding: 0;
        }

        .logo-svg {
            height: 40px;
            width: auto;
            display: block;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
            align-items: center;
        }

        .nav-links a {
            color: #0f172a;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .nav-links a:hover {
            color: var(--accent-blue);
        }

        .nav-phone {
            color: #0f172a !important;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            font-size: 0.9rem !important;
            padding: 0.5rem 1rem;
            border: 1px solid rgba(0, 0, 0, 0.15);
            border-radius: 6px;
            transition: all 0.2s ease;
        }
        
        .nav-phone:hover {
            border-color: var(--accent-blue);
            color: var(--accent-blue) !important;
            background: rgba(0, 78, 166, 0.04);
        }

        /* =========================================
           HERO СЕКЦИЯ
           ========================================= */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 8rem 5% 4rem;
            max-width: 1280px;
            margin: 0 auto;
        }

        .hero-content {
            max-width: 700px;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            line-height: 1.1;
            margin-bottom: 1.5rem;
            color: #ffffff;
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-secondary);
            margin-bottom: 3rem;
            max-width: 550px;
            line-height: 1.6;
        }

        .hero-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 0.85rem 1.75rem;
            border-radius: 8px;
            font-family: 'Onest', sans-serif;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary-strict {
            background: var(--text-primary);
            color: var(--bg-deep);
            border: 1px solid var(--text-primary);
        }

        .btn-primary-strict:hover {
            background: #e2e8f0;
            border-color: #e2e8f0;
        }

        .btn-ghost {
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border-default);
        }

        .btn-ghost:hover {
            color: var(--text-primary);
            border-color: var(--border-hover);
            background: var(--bg-surface);
        }

        /* =========================================
           СЕКЦИИ
           ========================================= */
        .section {
            padding: 6rem 5%;
            max-width: 1280px;
            margin: 0 auto;
        }

        .section-header {
            margin-bottom: 3rem;
            max-width: 700px;
        }

        .section-label {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.8rem;
            color: var(--text-muted);
            font-weight: 500;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .section-label::before {
            content: '';
            width: 16px;
            height: 1px;
            background: var(--text-muted);
        }

        .section-header h2 {
            font-size: clamp(2rem, 4vw, 2.5rem);
            line-height: 1.2;
            margin-bottom: 1rem;
            color: var(--text-primary);
        }

        .section-header p {
            color: var(--text-secondary);
            font-size: 1.1rem;
        }

        /* =========================================
           ЦИФРЫ (Статистика)
           ========================================= */
        .stats-section {
            background: var(--bg-surface);
            border-top: 1px solid var(--border-default);
            border-bottom: 1px solid var(--border-default);
            padding: 4rem 5%;
        }

        .stats-grid {
            max-width: 1280px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            text-align: center;
        }

        .stat-item h3 {
            font-size: 3rem;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
            line-height: 1;
            font-weight: 700;
        }

        .stat-item p {
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* =========================================
           КАРТОЧКИ УСЛУГ
           ========================================= */
        .bento-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }

        .bento-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: 12px;
            padding: 2rem;
        }

        .bento-card.wide { grid-column: span 2; }

        .bento-card:hover {
            background: var(--bg-surface-hover);
            border-color: var(--border-hover);
        }

        .bento-card h3 {
            font-size: 1.15rem;
            margin-bottom: 0.75rem;
            color: var(--text-primary);
        }

        .bento-card p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .bento-card ul {
            list-style: none;
            padding: 0;
        }

        .bento-card ul li {
            color: var(--text-secondary);
            font-size: 0.9rem;
            padding: 0.3rem 0;
            padding-left: 1.2rem;
            position: relative;
        }

        .bento-card ul li::before {
            content: '—';
            position: absolute;
            left: 0;
            color: var(--text-muted);
        }

        /* =========================================
           КЕЙСЫ (Объекты)
           ========================================= */
        .cases-section {
            background: var(--bg-surface);
            padding: 6rem 5%;
        }

        .cases-grid {
            max-width: 1280px;
            margin: 0 auto;
            display: grid;
            gap: 1.5rem;
        }

        .case-card {
            background: var(--bg-deep);
            border: 1px solid var(--border-default);
            border-radius: 12px;
            padding: 2rem;
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
            align-items: center;
        }

        .case-card:hover {
            border-color: var(--border-hover);
        }

        .case-info h3 {
            font-size: 1.35rem;
            margin-bottom: 0.75rem;
            color: var(--text-primary);
        }

        .case-meta {
            display: flex;
            gap: 1.5rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }

        .case-meta-item {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .case-meta-item strong {
            color: var(--text-secondary);
            font-weight: 600;
        }

        .case-description {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .case-stats {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding-left: 2rem;
            border-left: 1px solid var(--border-default);
        }

        .case-stat {
            text-align: left;
        }

        .case-stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            font-family: 'JetBrains Mono', monospace;
        }

        .case-stat-label {
            font-size: 0.8rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* =========================================
           ГАЛЕРЕЯ ТЕХНИКИ
           ========================================= */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
            align-items: stretch;
        }

        .gallery-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: 12px;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .gallery-card.wide { grid-column: span 2; }

        .gallery-card:hover {
            border-color: var(--border-hover);
        }

        .gallery-image {
            position: relative;
            width: 100%;
            flex-grow: 1;
            min-height: 280px;
            overflow: hidden;
            background: var(--bg-deep);
        }

        .gallery-image img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center center;
            filter: grayscale(40%) contrast(1.05);
            display: block;
        }

        .gallery-card:hover .gallery-image img {
            filter: grayscale(0%) contrast(1);
        }

        .gallery-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(2, 6, 23, 0.95) 0%, rgba(2, 6, 23, 0.4) 60%, transparent 100%);
            display: flex;
            align-items: flex-end;
            padding: 1.75rem;
            z-index: 2;
        }

        .gallery-tag {
            display: inline-block;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-primary);
            padding: 0.25rem 0.75rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 600;
            font-family: 'JetBrains Mono', monospace;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
        }

        .gallery-content h3 {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
        }

        .gallery-content p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            line-height: 1.5;
        }

        /* =========================================
           КЛИЕНТЫ
           ========================================= */
        .clients-section {
            background: var(--bg-surface);
            padding: 4rem 5%;
            border-top: 1px solid var(--border-default);
            border-bottom: 1px solid var(--border-default);
        }

        .clients-grid {
            max-width: 1280px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            align-items: center;
        }

        .client-logo {
            background: var(--bg-deep);
            border: 1px solid var(--border-default);
            border-radius: 8px;
            padding: 2rem;
            text-align: center;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-secondary);
            transition: all 0.2s ease;
        }

        .client-logo:hover {
            border-color: var(--border-hover);
            color: var(--text-primary);
        }

        /* =========================================
           ЛИЦЕНЗИИ
           ========================================= */
        .licenses-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }

        .license-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: 12px;
            padding: 2rem;
        }

        .license-card:hover {
            border-color: var(--border-hover);
        }

        .license-card h3 {
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
        }

        .license-card p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .license-number {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* =========================================
           КОНТАКТЫ
           ========================================= */
        .contacts-section {
            text-align: center;
            padding-bottom: 6rem;
        }

        .contact-block {
            display: inline-flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 2rem;
        }

        .contact-phone {
            font-family: 'JetBrains Mono', monospace;
            font-size: clamp(1.5rem, 3vw, 2.25rem);
            font-weight: 600;
            color: var(--text-primary);
            text-decoration: none;
            transition: color 0.2s;
        }

        .contact-phone:hover {
            color: #3b82f6;
        }

        .contact-email {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 1.1rem;
            transition: color 0.2s;
        }
        .contact-email:hover { color: var(--text-primary); }

        .contact-address {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-top: 1rem;
            line-height: 1.6;
        }

        /* =========================================
           АДАПТИВНОСТЬ
           ========================================= */
        @media (max-width: 1024px) {
            .bento-grid { grid-template-columns: repeat(2, 1fr); }
            .bento-card.wide { grid-column: span 2; }
            .gallery-grid { grid-template-columns: repeat(2, 1fr); }
            .gallery-card.wide { grid-column: span 2; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 3rem; }
            .clients-grid { grid-template-columns: repeat(2, 1fr); }
            .licenses-grid { grid-template-columns: repeat(2, 1fr); }
            .case-card { grid-template-columns: 1fr; }
            .case-stats { border-left: none; border-top: 1px solid var(--border-default); padding-left: 0; padding-top: 1.5rem; flex-direction: row; justify-content: space-around; }
        }

        @media (max-width: 768px) {
            .nav-links { display: none; }
            .hero { padding-top: 6rem; text-align: center; }
            .hero-content { margin: 0 auto; }
            .hero-actions { justify-content: center; }
            
            .bento-grid, .gallery-grid, .licenses-grid { grid-template-columns: 1fr; }
            .bento-card.wide, .gallery-card.wide { grid-column: span 1; }
            .stats-grid, .clients-grid { grid-template-columns: 1fr; gap: 2.5rem; }
            .case-stats { flex-direction: column; gap: 1rem; }
        }
    </style>
</head>
<body>

    <!-- Навигация -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="#" class="logo-link">
                <Logo />
            </a>
            <ul class="nav-links">
                <li><a href="#services">Услуги</a></li>
                <li><a href="#cases">Объекты</a></li>
                <li><a href="#equipment">Техника</a></li>
                <li><a href="#licenses">Лицензии</a></li>
                <li><a href="tel:+78633034567" class="nav-phone">+7 (863) 303-45-67</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero Секция -->
    <section class="hero">
        <div class="hero-content">
            <h1>Проектирование и строительство ВОЛС под ключ</h1>
            <p>Собственный парк из 87 единиц техники и штат из 156 аттестованных инженеров. Строим магистральные и внутризоновые линии связи в 34 регионах ЮФО и СКФО с 2012 года.</p>
            
            <div class="hero-actions">
                <a href="#contacts" class="btn btn-primary-strict">Связаться с нами</a>
                <a href="#cases" class="btn btn-ghost">
                    Смотреть объекты 
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Цифры -->
    <section class="stats-section">
        <div class="stats-grid">
            <div class="stat-item">
                <h3 class="mono">4 847 км</h3>
                <p>Построено ВОЛС</p>
            </div>
            <div class="stat-item">
                <h3 class="mono">127</h3>
                <p>Завершённых объектов</p>
            </div>
            <div class="stat-item">
                <h3 class="mono">98%</h3>
                <p>Сдачи с первого раза</p>
            </div>
            <div class="stat-item">
                <h3 class="mono">12 лет</h3>
                <p>На рынке (с 2012)</p>
            </div>
        </div>
    </section>

    <!-- Услуги -->
    <section class="section" id="services">
        <div class="section-header">
            <span class="section-label">Направления</span>
            <h2>Комплексные решения для связи</h2>
            <p>Выполняем весь цикл работ: от изысканий и проектирования до сдачи в эксплуатацию и паспортизации</p>
        </div>

        <div class="bento-grid">
            <div class="bento-card wide">
                <h3>Строительство магистральных ВОЛС</h3>
                <p>Прокладка оптического кабеля ёмкостью до 288 волокон траншейным способом и методом ГНБ на глубину до 2 метров. Подвес на опорах ЛЭП 6-110 кВ и контактной сети железных дорог.</p>
                <ul>
                    <li>Траншейная прокладка кабеля</li>
                    <li>Горизонтально-направленное бурение (ГНБ)</li>
                    <li>Подвес на существующих опорах</li>
                    <li>Работа в охранной зоне ж/д</li>
                </ul>
            </div>

            <div class="bento-card">
                <h3>Сварка и монтаж муфт</h3>
                <p>Монтаж тупиковых, проходных и ответвительных муфт МТОУ, МТОК. Сварка волокон аппаратами Fujikura 80S и Sumitomo Type-81C, время сварки одного волокна — 90 секунд.</p>
                <ul>
                    <li>Монтаж муфт всех типов</li>
                    <li>Сварка волокон</li>
                    <li>Контроль качества OTDR</li>
                </ul>
            </div>

            <div class="bento-card">
                <h3>Рефлексометрия (OTDR)</h3>
                <p>Измерения рефлектометрами EXFO FTB-1 и Viavi MTS-2000 на всех этапах строительства. Предоставление протоколов и рефлектограмм по форме заказчика.</p>
                <ul>
                    <li>Входной контроль кабеля</li>
                    <li>Измерения после сварки</li>
                    <li>Приёмо-сдаточные испытания</li>
                </ul>
            </div>

            <div class="bento-card wide">
                <h3>Проектирование и сдача в эксплуатацию</h3>
                <p>Разработка проектной документации стадий П и Р. Согласование трасс с балансодержателями, Росреестром и администрациями. Полное сопровождение процедуры приёмки работ.</p>
                <ul>
                    <li>Проектирование стадий П и Р</li>
                    <li>Согласование с балансодержателями</li>
                    <li>Сдача в эксплуатацию</li>
                    <li>Гарантия до 5 лет</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Кейсы (Объекты) -->
    <section class="cases-section" id="cases">
        <div class="section-header" style="max-width: 1280px; margin: 0 auto 3rem;">
            <span class="section-label">Объекты</span>
            <h2>Реализованные проекты</h2>
            <p>Последние завершённые объекты строительства ВОЛС</p>
        </div>

        <div class="cases-grid" style="max-width: 1280px; margin: 0 auto;">
            <!-- Кейс 1 -->
            <div class="case-card">
                <div class="case-info">
                    <h3>Магистральная ВОЛС Краснодар — Ростов-на-Дону</h3>
                    <div class="case-meta">
                        <div class="case-meta-item"><strong>Заказчик:</strong> ПАО «Ростелеком»</div>
                        <div class="case-meta-item"><strong>Год:</strong> 2023</div>
                        <div class="case-meta-item"><strong>Тип работ:</strong> Прокладка в грунт</div>
                    </div>
                    <p class="case-description">Строительство магистральной волоконно-оптической линии связи протяжённостью 340 км. Пересечение 3 федеральных трасс, работа в охранной зоне железной дороги. Сдача объекта на 2 недели раньше срока.</p>
                </div>
                <div class="case-stats">
                    <div class="case-stat">
                        <div class="case-stat-value">340 км</div>
                        <div class="case-stat-label">Длина линии</div>
                    </div>
                    <div class="case-stat">
