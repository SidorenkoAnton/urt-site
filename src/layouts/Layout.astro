---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionRail from '../components/SectionRail.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ЮЖРЕГИОНТЕЛЕКОМ — строительство ВОЛС под ключ',
  description = 'Проектирование и строительство волоконно-оптических линий связи под ключ: магистральные ВОЛС, прокладка в грунт и ГНБ, подвес на опорах, сварка и измерения. Собственная техника, допуск СРО, работаем по всей России.',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#061a24" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>

    <Header />
    <SectionRail />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <nav class="mobile-bar" aria-label="Быстрая связь">
      <a href="tel:+70000000000">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6.5 3.5 9 3l2 5-2.2 1.6a14 14 0 0 0 5.6 5.6L16 13l5 2-.5 2.5a2 2 0 0 1-2 1.6A16 16 0 0 1 4.9 5.5a2 2 0 0 1 1.6-2Z" />
        </svg>
        Позвонить
      </a>
      <a href="mailto:info@yrt-telecom.ru">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3.5 6.5 8.5 6 8.5-6" />
        </svg>
        Написать
      </a>
    </nav>
  </body>
</html>
