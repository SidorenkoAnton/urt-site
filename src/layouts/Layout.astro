---
import cable from '../assets/cable.jpg'
import office from '../assets/office.jpg'
import svarka from '../assets/svarka.jpg'
import factory from '../assets/factory.jpg'
import Logo from './Logo.astro'
---

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ЮЖРЕГИОНТЕЛЕКОМ — Строительство ВОЛС под ключ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&family=Golos+Text:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-deep: #020617;
            --bg-surface: rgba(15, 23, 42, 0.6);
            --bg-surface-hover: rgba(30, 41, 59, 0.8);
            
            --border-default: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(74, 172, 225, 0.4);
            
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            
            --accent-glow: rgba(0, 78, 166, 0.15);
            --accent-blue: #004ea6;
            --accent-cyan: #4aace1;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        
        body {
            font-family: 'Golos Text', sans-serif;
            background-color: var(--bg-deep);
            color: var(--text-primary);
            overflow-x: hidden;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        /* Текстура шума для премиального ощущения */
        .bg-noise {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: -1;
        }

        /* Глобальный фоновый градиент */
        .bg-gradient-mesh {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: 
                radial-gradient(circle at 15% 50%, rgba(0, 78, 166, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(74, 172, 225, 0.05) 0%, transparent 50%);
            z-index: -2;
            pointer-events: none;
        }

        h1, h2, h3 { font-family: 'Onest', sans-serif; font-weight: 700; letter-spacing: -0.03em; }
        .mono { font-family: 'JetBrains Mono', monospace; }

        /* =========================================
           НАВИГАЦИЯ (GLASSMORPHISM)
           ========================================= */
        .navbar {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            background: rgba(2, 6, 23, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-default);
            padding: 1rem 5%;
            transition: all 0.3s ease;
        }

        .nav-container {
            max-width: 1280px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-link {
            display: flex;
            align-items: center;
            text-decoration: none;
        }

        .nav-links {
            display: flex;
            gap: 2.5rem;
            list-style: none;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.2s ease;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--accent-cyan);
            transition: width 0.3s ease;
        }

        .nav-links a:hover { color: var(--text-primary); }
        .nav-links a:hover::after { width: 100%; }

        .nav-phone {
            color: var(--text-primary) !important;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            font-size: 0.85rem !important;
            padding: 0.6rem 1.2rem;
            border: 1px solid var(--border-default);
            border-radius: 8px;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.03);
        }
        
        .nav-phone:hover {
            border-color: var(--accent-cyan);
            background: rgba(74, 172, 225, 0.1);
            box-shadow: 0 0 15px rgba(74, 172, 225, 0.1);
        }
        .nav-phone::after { display: none; }

        /* =========================================
           HERO СЕКЦИЯ
           ========================================= */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 8rem 5% 4rem;
            max-width: 1280px;
            margin: 0 auto;
        }

        .hero-watermark {
            position: absolute;
            right: -10%;
            top: 50%;
            transform: translateY(-50%);
            width: 800px;
            height: auto;
            opacity: 0.02;
            z-index: -1;
            pointer-events: none;
            filter: blur(2px);
        }

        .hero-content {
            max-width: 750px;
            position: relative;
            z-index: 2;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(74, 172, 225, 0.05);
            border: 1px solid rgba(74, 172, 225, 0.2);
            color: var(--accent-cyan);
            padding: 0.5rem 1.2rem;
            border-radius: 100px;
            font-size: 0.8rem;
            font-weight: 600;
            font-family: 'JetBrains Mono', monospace;
            margin-bottom: 2rem;
            animation: fadeInUp 0.8s ease-out forwards;
        }

        .hero-badge::before {
            content: '';
            width: 6px; height: 6px;
            background: var(--accent-cyan);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--accent-cyan);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .hero h1 {
            font-size: clamp(3rem, 6vw, 4.5rem);
            line-height: 1.05;
            margin-bottom: 1.5rem;
            background: linear-gradient(180deg, #ffffff 0%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: fadeInUp 0.8s ease-out 0.2s forwards;
            opacity: 0;
        }

        .hero p {
            font-size: 1.25rem;
            color: var(--text-secondary);
            margin-bottom: 3rem;
            max-width: 600px;
            line-height: 1.7;
            animation: fadeInUp 0.8s ease-out 0.4s forwards;
            opacity: 0;
        }

        .hero-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            animation: fadeInUp 0.8s ease-out 0.6s forwards;
            opacity: 0;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .btn {
            padding: 1rem 2rem;
            border-radius: 10px;
            font-family: 'Onest', sans-serif;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-blue) 0%, #003d82 100%);
            color: #ffffff;
            border: 1px solid rgba(74, 172, 225, 0.3);
            box-shadow: 0 4px 20px rgba(0, 78, 166, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 78, 166, 0.5);
            border-color: var(--accent-cyan);
        }

        .btn-ghost {
            background: rgba(255, 255, 255, 0.03);
            color: var(--text-primary);
            border: 1px solid var(--border-default);
        }

        .btn-ghost:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: var(--border-hover);
        }

        /* =========================================
           СЕКЦИИ
           ========================================= */
        .section {
            padding: 8rem 5%;
            max-width: 1280px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        .section-header {
            margin-bottom: 4rem;
            max-width: 650px;
        }

        .section-label {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: var(--accent-cyan);
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .section-label::before {
            content: '';
            width: 24px;
            height: 2px;
            background: var(--accent-cyan);
            border-radius: 2px;
        }

        .section-header h2 {
            font-size: clamp(2.2rem, 4vw, 3rem);
            line-height: 1.15;
            margin-bottom: 1.25rem;
            color: var(--text-primary);
        }

        .section-header p {
            color: var(--text-secondary);
            font-size: 1.15rem;
            line-height: 1.7;
        }

        /* =========================================
           КАРТОЧКИ УСЛУГ (BENTO PREMIUM)
           ========================================= */
        .bento-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }

        .bento-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: 16px;
            padding: 2.5rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .bento-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(74, 172, 225, 0.5), transparent);
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .bento-card.wide { grid-column: span 2; }

        .bento-card:hover {
            background: var(--bg-surface-hover);
            border-color: var(--border-hover);
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
        }

        .bento-card:hover::before { opacity: 1; }

        .card-icon {
            width: 48px; height: 48px;
            background: rgba(74, 172, 225, 0.05);
            border: 1px solid rgba(74, 172, 225, 0.2);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.75rem;
            color: var(--accent-cyan);
            transition: all 0.3s ease;
        }

        .bento-card:hover .card-icon {
            background: rgba(74, 172, 225, 0.1);
            border-color: var(--accent-cyan);
            box-shadow: 0 0 15px rgba(74, 172, 225, 0.15);
        }

        .bento-card h3 {
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
            color: var(--text-primary);
        }

        .bento-card p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.7;
        }

        /* =========================================
           ГАЛЕРЕЯ
           ========================================= */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
            align-items: stretch;
        }

        .gallery-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            height: 100%;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .gallery-card.wide { grid-column: span 2; }

        .gallery-card:hover {
            border-color: var(--border-hover);
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
        }

        .gallery-image {
            position: relative;
            width: 100%;
            flex-grow: 1;
            min-height: 320px;
            overflow: hidden;
        }

        .gallery-image img {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            object-fit: cover;
            filter: grayscale(30%) contrast(1.1) brightness(0.8);
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .gallery-card:hover .gallery-image img {
            filter: grayscale(0%) contrast(1) brightness(0.9);
            transform: scale(1.08);
        }

        .gallery-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(2, 6, 23, 0.95) 0%, rgba(2, 6, 23, 0.2) 50%, transparent 100%);
            display: flex;
            align-items: flex-end;
            padding: 2rem;
            z-index: 2;
        }

        .gallery-content {
            transform: translateY(10px);
            transition: transform 0.4s ease;
        }

        .gallery-card:hover .gallery-content { transform: translateY(0); }

        .gallery-tag {
            display: inline-block;
            background: rgba(74, 172, 225, 0.15);
            border: 1px solid rgba(74, 172, 225, 0.3);
            color: var(--accent-cyan);
            padding: 0.3rem 0.8rem;
            border-radius: 6px;
            font-size: 0.7rem;
            font-weight: 600;
            font-family: 'JetBrains Mono', monospace;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
            backdrop-filter: blur(4px);
        }

        .gallery-content h3 {
            font-size: 1.35rem;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
        }

        .gallery-content p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            line-height: 1.6;
            opacity: 0.8;
        }

        /* =========================================
           СТАТИСТИКА
           ========================================= */
        .stats-section {
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.4) 0%, rgba(2, 6, 23, 0.8) 100%);
            border-top: 1px solid var(--border-default);
            border-bottom: 1px solid var(--border-default);
            padding: 6rem 5%;
            position: relative;
            overflow: hidden;
        }

        .stats-section::before {
            content: '';
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(0, 78, 166, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .stats-grid {
            max-width: 1280px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            text-align: center;
            position: relative;
            z-index: 1;
        }

        .stat-item h3 {
            font-size: clamp(2.5rem, 4vw, 3.5rem);
            background: linear-gradient(180deg, #ffffff 0%, #4aace1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.75rem;
            line-height: 1;
            font-weight: 700;
        }

        .stat-item p {
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        /* =========================================
           КОНТАКТЫ (Бесшовный футер)
           ========================================= */
        .contacts-section {
            text-align: center;
            padding: 8rem 5% 6rem;
            position: relative;
        }

        .contact-block {
            display: inline-flex;
            flex-direction: column;
            gap: 1.25rem;
            margin-top: 3rem;
            padding: 3rem;
            background: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: 24px;
            position: relative;
            overflow: hidden;
        }

        .contact-block::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent-cyan), transparent);
        }

        .contact-phone {
            font-family: 'Onest', sans-serif;
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 700;
            color: var(--text-primary);
            text-decoration: none;
            transition: all 0.3s ease;
            letter-spacing: -0.02em;
        }

        .contact-phone:hover {
            color: var(--accent-cyan);
            text-shadow: 0 0 20px rgba(74, 172, 225, 0.3);
        }

        .contact-email {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 1.2rem;
            font-weight: 500;
            transition: color 0.2s;
        }
        .contact-email:hover { color: var(--text-primary); }

        .footer-bottom {
            margin-top: 4rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border-default);
            color: var(--text-muted);
            font-size: 0.85rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1280px;
            margin-left: auto;
            margin-right: auto;
        }

        /* =========================================
           АДАПТИВНОСТЬ
           ========================================= */
        @media (max-width: 1024px) {
            .bento-grid { grid-template-columns: repeat(2, 1fr); }
            .bento-card.wide { grid-column: span 2; }
            .gallery-grid { grid-template-columns: repeat(2, 1fr); }
            .gallery-card.wide { grid-column: span 2; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 3rem; }
        }

        @media (max-width: 768px) {
            .nav-links { display: none; } /* Здесь можно добавить бургер-меню */
            .hero { padding-top: 6rem; text-align: center; }
            .hero-content { margin: 0 auto; }
            .hero-actions { justify-content: center; }
            .hero-watermark { width: 400px; right: -30%; opacity: 0.02; }
            
            .bento-grid, .gallery-grid { grid-template-columns: 1fr; }
            .bento-card.wide, .gallery-card.wide { grid-column: span 1; }
            .stats-grid { grid-template-columns: 1fr; gap: 2.5rem; }
            
            .contact-block { padding: 2rem 1.5rem; width: 100%; }
            .footer-bottom { flex-direction: column; gap: 1rem; text-align: center; }
        }
    </style>
</head>
<body>

    <div class="bg-noise"></div>
    <div class="bg-gradient-mesh"></div>

    <!-- Навигация (Glassmorphism) -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="#" class="logo-link"><Logo/></a>
            <ul class="nav-links">
                <li><a href="#services">Услуги</a></li>
                <li><a href="#equipment">Техника</a></li>
                <li><a href="#stats">Опыт</a></li>
                <li><a href="tel:+70000000000" class="nav-phone">+7 (XXX) XXX-XX-XX</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero Секция -->
    <section class="hero">
        <!-- Упрощенный водяной знак на основе формы логотипа -->
        <svg class="hero-watermark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1124 380" aria-hidden="true">
            <path fill="currentColor" d="M 1200.1,1367.08 l -142.87,540.65 l 288.53,299.73 l 198.89,-98.04 l -2.8,-182.08 l -236.77,-105.11 l -14.25,-477.09 l -90.73,21.94 Z M 1854.95,920.949 l 157.13,-211.176 l -269.72,-86.25 Z" transform="scale(0.8) translate(-800, -600)" />
        </svg>

        <div class="hero-content">
            <div class="hero-badge">Допуски СРО · Работаем по всей РФ</div>
            <h1>Проектирование и строительство ВОЛС под ключ</h1>
            <p>Собственный парк техники и штат аттестованных инженеров. Строим магистральные и внутризоновые линии связи с гарантией качества и соблюдением сроков.</p>
            
            <div class="hero-actions">
                <a href="#contacts" class="btn btn-primary">
                    Обсудить проект
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="#equipment" class="btn btn-ghost">
                    Смотреть технику 
                </a>
            </div>
        </div>
    </section>

    <!-- Секция Услуг -->
    <section class="section" id="services">
        <div class="section-header">
            <span class="section-label">Направления</span>
            <h2>Комплексные решения для связи</h2>
            <p>Выполняем весь цикл работ: от изысканий и проектирования до сдачи в эксплуатацию и паспортизации</p>
        </div>

        <div class="bento-grid">
            <div class="bento-card wide">
                <div class="card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                </div>
                <h3>Строительство магистральных ВОЛС</h3>
                <p>Прокладка оптического кабеля в грунт (траншейным способом и методом ГНБ), а также подвес на опорах ЛЭП и контактной сети железных дорог.</p>
            </div>

            <div class="bento-card">
                <div class="card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                </div>
                <h3>Сварка и монтаж муфт</h3>
                <p>Квалифицированный монтаж оптических муфт и кроссов. Сварка волокон аппаратами Fujikura и Sumitomo.</p>
            </div>

            <div class="bento-card">
                <div class="card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                </div>
                <h3>Рефлексометрия (OTDR)</h3>
                <p>Проведение измерительных работ на всех этапах. Предоставляем полные пакеты документации и рефлектограммы.</p>
            </div>

            <div class="bento-card wide">
                <div class="card-icon">
